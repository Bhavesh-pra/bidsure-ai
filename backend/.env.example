# BidSure Backend — Environment Configuration
# Copy this file to .env and fill in values for your environment.
# NEVER commit .env with real secrets.

# ─── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# ─── CORS ──────────────────────────────────────────────────────────────────
# The exact origin of the frontend application (no trailing slash).
# In production, change this to your deployed frontend URL.
FRONTEND_ORIGIN=http://localhost:5173

# ─── Logging ───────────────────────────────────────────────────────────────
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# ─── Rate Limiting ─────────────────────────────────────────────────────────
# Window size in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000
# Max requests per window per IP (default: 100)
RATE_LIMIT_MAX=100

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require"

# ─── Future phases (placeholders — do not activate until the relevant phase) ─
# JWT_SECRET=<long-random-string>
# SESSION_SECRET=<long-random-string>
