# Flask Application Configuration
FLASK_APP=backend/run.py
FLASK_ENV=development
SECRET_KEY=bidsure-dev-secret-key-change-in-production
PORT=5000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://bidsure:bidsure123@localhost:5432/bidsure_db
POSTGRES_USER=bidsure
POSTGRES_PASSWORD=bidsure123
POSTGRES_DB=bidsure_db
POSTGRES_PORT=5432

# Security & Authentication
JWT_SECRET=jwt-dev-secret-key-bidsure-2026
JWT_REFRESH_SECRET=jwt-refresh-dev-secret-key-bidsure-2026
JWT_SECRET_KEY=jwt-dev-secret-key-bidsure-2026
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# Object Storage Configuration (S3 / R2 Compatible)
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET=bidsure-documents
S3_ACCESS_KEY=your-access-key-id
S3_SECRET_KEY=your-secret-access-key
S3_REGION=us-east-1

# Intelligence & OCR Options
OCR_ENGINE=tesseract
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini
