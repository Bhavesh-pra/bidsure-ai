# Database configuration
DATABASE_URL=postgresql://bidsure_user:bidsure_password@localhost:5432/bidsure_db

# Security & Authentication
JWT_SECRET=your-jwt-secret-key-min-32-chars
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-min-32-chars

# S3 / MinIO Object Storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=bidsure-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# AI / Extraction Services
LLM_API_KEY=your-gemini-or-openai-api-key
LLM_MODEL=gemini-2.5-flash
